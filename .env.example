# Copy to .env and fill in as needed. Never commit .env.
#
# The application runs with none of these set: without the voice settings the
# page simply says live voice is not configured.

# Where the SQLite file lives.
WARMLINE_DB=warmline.sqlite3

# Which provider the call endpoint uses. "simulated" is the only wired one.
CALL_PROVIDER=simulated

# Extra browser origins allowed to call the API, comma-separated.
WARMLINE_ALLOWED_ORIGINS=

# Shared secret for verifying the post-call webhook's HMAC signature.
WARMLINE_WEBHOOK_SECRET=

# --- live voice sessions in the browser --------------------------------------
#
# All three must be set for the "talk to the agent" panel to work. The key stays
# on the server; the browser only ever receives a single-use session token.

ELEVENLABS_API_KEY=
# Written here by `python -m warmline.voice.sync_agent` on first run.
ELEVENLABS_AGENT_ID=
# What visitors type to start a session. Send it with the link.
WARMLINE_VOICE_PASSCODE=

# Optional.
WARMLINE_VOICE_SESSIONS_PER_HOUR=10
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=claude-sonnet-4-5

# --- outbound phone calls, which this build does not place ------------------

# Required to construct ElevenLabsProvider at all. Set this only if you have
# read docs/SPEC.md section 2 and the destination is a number you own.
WARMLINE_ALLOW_LIVE_CALLS=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Tier 2 claim adjudication, run by hand from evals/. Never used in CI.
ANTHROPIC_API_KEY=
