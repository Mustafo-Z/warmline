# Copy to .env and fill in as needed. Never commit .env.
#
# The application runs with none of these set. Every one of them is either
# optional or belongs to a code path this build does not use.

# Where the SQLite file lives.
WARMLINE_DB=warmline.sqlite3

# Which provider the call endpoint uses. "simulated" is the only wired one.
CALL_PROVIDER=simulated

# Shared secret for verifying the post-call webhook's HMAC signature.
# Only needed if you are exercising the webhook route.
WARMLINE_WEBHOOK_SECRET=

# --- everything below belongs to code that does not run in this build -------

# Required to construct ElevenLabsProvider at all. This build places no calls;
# set this only if you have read docs/SPEC.md section 2 and the destination is
# a number you own.
WARMLINE_ALLOW_LIVE_CALLS=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Tier 2 claim adjudication, run by hand from evals/. Never used in CI.
ANTHROPIC_API_KEY=
